use strict;
use warnings;
use JSON::PP qw(decode_json encode_json);
use File::Basename qw(dirname);
use File::Temp qw(tempfile);
use Fcntl qw(:flock);
use Digest::SHA qw(sha256_hex);

# Call the user's existing status line with the original stdin if supplied.
local $/;
my $input = <STDIN> // '';
sub save_weekly {
    my $data = eval { decode_json($input) };
    return unless ref($data) eq 'HASH' && ref($data->{rate_limits}) eq 'HASH';
    my $weekly = $data->{rate_limits}{seven_day};
    return unless ref($weekly) eq 'HASH';
    my ($used, $reset) = @{$weekly}{qw(used_percentage resets_at)};
    my $now = time;
    return unless defined($used) && $used =~ /\A\d+(\.\d+)?\z/ && $used <= 100;
    return unless defined($reset) && $reset =~ /\A\d+\z/ && $reset > $now && $reset <= 4294967295;

    my $dir = dirname($0);
    my $snapshot = "$dir/claude-weekly.json";
    my $remaining = int(100 - $used + 0.5);
    open my $lock, '>>', "$dir/claude-weekly.lock" or return;
    flock($lock, LOCK_EX) or return;
    # Existing status lines can re-run on a timer. Count a new response
    # even when its quota rounds to the same percentage.
    my $duration = ref($data->{cost}) eq 'HASH' ? $data->{cost}{total_api_duration_ms} : undef;
    my $response = defined($data->{session_id}) && defined($duration)
        ? sha256_hex(encode_json([$data->{session_id}, $data->{prompt_id}, $duration, $used, $reset]))
        : undef;
    if (defined($response) && open my $previous, '<', $snapshot) {
        my $old = eval { decode_json(<$previous>) };
        return if ref($old) eq 'HASH' && ($old->{response} // '') eq $response;
    }
    my ($file, $temp) = tempfile(DIR => $dir);
    my %reading = (remainingPercent => $remaining, resetsAt => 0 + $reset, observedAt => $now);
    $reading{response} = $response if defined($response);
    print {$file} encode_json(\%reading);
    if (!close($file) || !rename($temp, $snapshot)) { unlink $temp; }
}
eval { save_weekly() };
if (@ARGV) {
    local $SIG{PIPE} = 'IGNORE';
    open my $status_line, '|-', '/bin/sh', '-c', $ARGV[0] or exit 1;
    print {$status_line} $input;
    close($status_line);
}
