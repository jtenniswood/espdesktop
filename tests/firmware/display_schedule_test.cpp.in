using namespace espdesktop;
#define id(x) x
#define ESP_LOGD(...) log_stub(__VA_ARGS__)
#define ESP_LOGW(...) log_stub(__VA_ARGS__)
template<typename... T> void log_stub(T...) {}
uint32_t now_ms = 1000;
uint32_t millis() { return now_ms; }
using Next = std::function<void()>;
struct Event { uint32_t at; Next next; };
std::vector<Event> events;
void later(uint32_t delay, Next next) { events.push_back({now_ms + delay, std::move(next)}); }
void advance(uint32_t ms) {
  const auto end = now_ms + ms;
  while (!events.empty()) {
    auto first = std::min_element(events.begin(), events.end(),
        [](const Event &a, const Event &b) { return a.at < b.at; });
    if (first->at > end) break;
    auto event = *first;
    events.erase(first);
    now_ms = event.at;
    event.next();
  }
  now_ms = end;
}
using Step = std::function<void(Next)>;
using Steps = std::vector<Step>;
struct Script {
  Steps steps;
  std::array<int, 3> args{};
  Next io;
  unsigned epoch = 0;
  bool running = false;
  int calls = 0;
  void run(size_t index, unsigned token) {
    if (epoch != token) return;
    if (index == steps.size()) { running = false; return; }
    steps[index]([this, index, token] { run(index + 1, token); });
  }
  void execute(int a = 0, int b = 0, int c = 0) {
    stop(); args = {a, b, c}; ++calls; running = true;
    if (io) io();
    run(0, epoch);
  }
  void stop() { ++epoch; running = false; }
  bool is_running() const { return running; }
};
Step call(Next fn) { return [fn](Next next) { fn(); next(); }; }
Step pause(std::function<uint32_t()> duration) {
  return [duration](Next next) { later(duration(), next); };
}
void poll(Script &script, Next next) {
  if (script.is_running()) later(1, [&script, next] { poll(script, next); });
  else next();
}
Step wait_for(Script &script) { return [&script](Next next) { poll(script, next); }; }
void run_branch(Script &owner, unsigned epoch, Steps steps, size_t index, Next next) {
  if (owner.epoch != epoch) return;
  if (index == steps.size()) { next(); return; }
  steps[index]([&owner, epoch, steps, index, next] { run_branch(owner, epoch, steps, index + 1, next); });
}
Step branch(Script &owner, std::function<bool()> condition, Steps yes, Steps no) {
  return [&owner, condition, yes, no](Next next) { run_branch(owner, owner.epoch, condition() ? yes : no, 0, next); };
}
// Hardware/settings boundary; production predicates use these values unchanged.
struct App {
  DisplayLifecycleService lifecycle;
  auto &display() { return lifecycle.controller(); }
  auto &display_lifecycle() { return lifecycle; }
} espdesktop_app;
struct Time { int hour = 6; bool valid = true; bool is_valid() const { return valid; } } clock_time;
struct Clock { Time now() { return clock_time; } } panel_time, homeassistant_time;
Time panel_time_or_fallback(Time primary, Time fallback) { return primary.valid ? primary : fallback; }
struct Page { int *obj; } home{nullptr}, setup{}, ha{}, actions{}, off{};
Page *main_page = &home, *button_setup_page = &setup, *ha_setup_page = &ha,
     *ha_actions_page = &actions, *screen_off_page = &off;
int *active_page = nullptr;
int *lv_scr_act() { return active_page; }
struct Text { std::string state; std::string current_option() { return state; } };
Text button_order{"1"}, screen_schedule_trigger{"time"}, screensaver_mode{"timer"};
struct Number { float state; } schedule_on_hour{7}, schedule_off_hour{22}, schedule_wake_timeout{60}, screensaver_timeout{300};
struct Toggle { bool state = false; } schedule_enabled{true};
bool connectivity_setup_display_active = false,
     schedule_mode_always_on = false, schedule_mode_clock = true,
     clock_bar_night_mode_active = false;
bool screensaver_companion_ready = true, mac_connected = true;
bool companion_connected() { return mac_connected; }
bool screensaver_action_clock = false, screensaver_action_dimmed = false,
     screensaver_action_camera = false;
uint32_t manual_wake_ms = 0;
uint32_t camera_screensaver_transition_generation = 0;
void image_card_resume_pipeline() {}
void navigation_return_home(int *) {}
// SCHEDULE_HELPERS
// SCRIPT_DECLARATIONS

void reset(DisplayMode night_mode = DisplayMode::CLOCK) {
  events.clear(); now_ms = 1000;
  screensaver_companion_ready = true; mac_connected = true;
  screen_lock_mac_locked() = false;
  screen_lock_mac_display_awake().reset();
  // Every modeled script, including delayed branches, is idle before a case.
  display_mode_reconcile.stop(); screen_schedule_check.stop(); screen_schedule_wake.stop();
  display_mode_apply_transition.stop(); display_mode_effect_active.stop();
  display_active_finalize.stop(); screensaver_idle_check.stop();
  screen_schedule_wake_timeout_check.stop(); schedule_wake_timeout.state = 60;
  screensaver_idle_check.calls = 0;
  clock_time = {6, true}; active_page = home.obj;
  schedule_enabled.state = true;
  screen_schedule_trigger.state = "time";
  schedule_mode_clock = night_mode == DisplayMode::CLOCK;
  schedule_mode_always_on = night_mode == DisplayMode::ACTIVE;
  manual_wake_ms = 0; screensaver_mode.state = "timer";
  screensaver_action_clock = screensaver_action_dimmed = screensaver_action_camera = false;
  espdesktop_app.lifecycle = {};
  auto &controller = espdesktop_app.display();
  controller.request(DisplayRequestSource::SCREEN_SCHEDULE, night_mode);
  controller.complete_transition(controller.resolve());
}
void assert_backlight_on_policy() {
  DisplayLifecycleService lifecycle;
  auto &controller = lifecycle.controller();
  assert(lifecycle.backlight_on_response(false) == BacklightOnResponse::KEEP_ON);
  assert(lifecycle.backlight_on_response(true) == BacklightOnResponse::KEEP_OFF);
  controller.request(DisplayRequestSource::SCREEN_SCHEDULE, DisplayMode::DISPLAY_OFF);
  const auto night = controller.resolve();
  assert(lifecycle.backlight_on_response(false) == BacklightOnResponse::KEEP_OFF);
  assert(controller.start_transition(night, 1));
  assert(controller.complete_transition(night, 2));
  assert(lifecycle.backlight_on_response(false) == BacklightOnResponse::KEEP_OFF);
  controller.clear(DisplayRequestSource::SCREEN_SCHEDULE);
  controller.resolve();
  assert(lifecycle.backlight_on_response(false) == BacklightOnResponse::WAKE);
}

int main() {
  assert_backlight_on_policy();
  // PANEL_SETTING_FIXTURES
  // Distinct LVGL objects so off/setup-page tests cannot match main by accident.
  int objects[5]{};
  home.obj = &objects[0]; setup.obj = &objects[1]; ha.obj = &objects[2];
  actions.obj = &objects[3]; off.obj = &objects[4];
  // SCRIPT_SETUP
  auto &controller = espdesktop_app.display();
  navigate_after_api.io = [] {
    active_page = home.obj;
    espdesktop_app.display_lifecycle().set_blank_page_active(false);
    display_active_finalize.execute();
  };
  display_mode_apply_transition.io = [&] {
    if (static_cast<DisplayMode>(display_mode_apply_transition.args[1]) != DisplayMode::ACTIVE)
      controller.complete_transition(controller.resolve(), millis());
  };
  register_screen_lock_changed_handler([](bool) { screensaver_companion_reconcile.execute(); });
  screensaver_wake.io = [&] { display_mode_clear_automatic.execute(); };
  auto reset_companion = [&] {
    reset();
    screensaver_mode.state = "companion";
    clock_time.hour = 9;
    controller.clear(DisplayRequestSource::SCREEN_SCHEDULE);
    controller.complete_transition(controller.resolve());
  };
  // Power changes wake and sleep the panel without clearing the lock.
  reset_companion();
  screen_lock_set_mac_locked(true, true);
  advance(10000);
  assert(controller.target_mode_is(DisplayMode::ACTIVE) && screen_lock_enabled());
  screen_lock_set_mac_locked(true, false);
  assert(controller.target_mode_is(DisplayMode::DISPLAY_OFF) && screen_lock_enabled());
  screen_lock_set_mac_locked(true, true);
  advance(500);
  assert(controller.current_mode_is(DisplayMode::ACTIVE) && screen_lock_enabled());
  screen_lock_set_mac_locked(true, false);
  screen_lock_set_mac_locked(false);
  advance(500);
  assert(controller.current_mode_is(DisplayMode::ACTIVE) && !screen_lock_enabled());

  // A disconnected or older Mac cannot keep the lock screen lit.
  reset_companion();
  screen_lock_set_mac_locked(true, true);
  mac_connected = false;
  screen_lock_mac_display_awake().reset();
  screensaver_companion_reconcile.execute();
  assert(controller.target_mode_is(DisplayMode::DISPLAY_OFF) && screen_lock_enabled());
  mac_connected = true;
  screensaver_companion_reconcile.execute();
  assert(controller.target_mode_is(DisplayMode::DISPLAY_OFF));
  screen_lock_set_mac_locked(true, true);
  assert(controller.target_mode_is(DisplayMode::ACTIVE));
  screen_lock_set_mac_locked(true);
  assert(controller.target_mode_is(DisplayMode::DISPLAY_OFF));

  for (auto action : {DisplayMode::CLOCK, DisplayMode::DIMMED}) {
    reset_companion();
    screensaver_action_clock = action == DisplayMode::CLOCK;
    screensaver_action_dimmed = action == DisplayMode::DIMMED;
    screen_lock_set_mac_locked(true, true);
    assert(controller.target_mode_is(action));
  }

  // The night schedule keeps priority. When it ends, an awake Mac keeps
  // the lock screen visible instead of handing off to automatic Display Off.
  reset();
  screensaver_mode.state = "companion";
  screen_lock_set_mac_locked(true, true);
  assert(controller.target_mode_is(DisplayMode::CLOCK));
  clock_time.hour = 9;
  display_mode_reconcile.execute();
  screen_schedule_check.execute();
  advance(500);
  assert(controller.current_mode_is(DisplayMode::ACTIVE) && screen_lock_enabled());

  // Scheduled dimming must not keep the lock screen lit during Mac sleep.
  reset(DisplayMode::ACTIVE);
  screensaver_mode.state = "companion";
  screen_lock_set_mac_locked(true, true);
  assert(controller.target_source_is(DisplayRequestSource::SCREEN_SCHEDULE));
  screen_lock_set_mac_locked(true, false);
  assert(controller.current_mode_is(DisplayMode::DISPLAY_OFF));
  assert(controller.target_source_is(DisplayRequestSource::MAC_DISPLAY_SLEEP));
  mac_connected = false;
  screensaver_companion_reconcile.execute();
  assert(controller.current_mode_is(DisplayMode::DISPLAY_OFF));
  mac_connected = true;
  screensaver_companion_reconcile.execute();
  assert(controller.current_mode_is(DisplayMode::DISPLAY_OFF));
  screen_lock_set_mac_locked(true, true);
  advance(500);
  assert(controller.current_mode_is(DisplayMode::ACTIVE) && screen_lock_enabled());
  assert(controller.target_source_is(DisplayRequestSource::SCREEN_SCHEDULE));

  // A temporary night wake cannot keep the panel lit when the Mac display sleeps.
  reset(DisplayMode::CLOCK);
  screensaver_mode.state = "companion";
  manual_wake_ms = millis();
  display_mode_reconcile.execute();
  assert(controller.target_source_is(DisplayRequestSource::USER_WAKE));
  screen_lock_set_mac_locked(true, false);
  assert(controller.target_source_is(DisplayRequestSource::MAC_DISPLAY_SLEEP));

  // Both callback orders, all scheduled modes, and a temporary night wake.
  for (auto mode : {DisplayMode::CLOCK, DisplayMode::DISPLAY_OFF, DisplayMode::ACTIVE}) {
    for (bool fast_first : {false, true}) {
      for (bool temporary_wake : {false, true}) {
        reset(mode);
        if (mode == DisplayMode::DISPLAY_OFF) {
          active_page = off.obj;
          espdesktop_app.display_lifecycle().set_blank_page_active(true);
        }
        controller.request(DisplayRequestSource::IDLE_TIMER, DisplayMode::DISPLAY_OFF);
        if (temporary_wake) {
          manual_wake_ms = millis();
          controller.request(DisplayRequestSource::USER_WAKE, DisplayMode::ACTIVE);
          controller.complete_transition(controller.resolve());
        }
        clock_time.hour = 7;
        (fast_first ? display_mode_reconcile : screen_schedule_check).execute();
        assert(screensaver_idle_check.calls == 0);  // Wait for presentation completion.
        (fast_first ? screen_schedule_check : display_mode_reconcile).execute();
        advance(500);
        assert(manual_wake_ms == 0);
        if (mode == DisplayMode::CLOCK && !temporary_wake) {
          assert(controller.current_mode_is(DisplayMode::DISPLAY_OFF));
          assert(screensaver_idle_check.calls == 0);
          continue;
        }
        assert(controller.current_mode_is(DisplayMode::ACTIVE));
        assert(screensaver_idle_check.is_running());
        const int starts = screensaver_idle_check.calls;
        for (int seconds = 0; seconds < 299; ++seconds) {
          display_mode_reconcile.execute();
          if (seconds % 60 == 0) screen_schedule_check.execute();
          advance(1000);
        }
        assert(screensaver_idle_check.calls == starts); // Polling cannot postpone sleep.
        assert(controller.target_mode_is(DisplayMode::ACTIVE));
        advance(1000);
        assert(controller.target_mode_is(DisplayMode::DISPLAY_OFF));
      }
    }
  }
  // A night clock hands off directly to every configured idle action, even
  // after boot when there is no hidden idle request to restore. The dashboard
  // must never brighten and no fresh five-minute countdown may start.
  for (bool fast_first : {false, true}) {
    {
      for (auto action : {DisplayMode::DISPLAY_OFF, DisplayMode::CLOCK,
                          DisplayMode::DIMMED}) {
        reset();
        screensaver_mode.state = "timer";
        screensaver_action_clock = action == DisplayMode::CLOCK;
        screensaver_action_dimmed = action == DisplayMode::DIMMED;
        const int active_effects = display_mode_effect_active.calls;
        const int brightness_writes = backlight_apply_brightness.calls;
        clock_time.hour = 9;
        (fast_first ? display_mode_reconcile : screen_schedule_check).execute();
        assert(controller.target_mode_is(action));
        (fast_first ? screen_schedule_check : display_mode_reconcile).execute();
        advance(1000);
        assert(controller.current_mode_is(action));
        assert(controller.target_source_is(DisplayRequestSource::IDLE_TIMER));
        assert(display_mode_effect_active.calls == active_effects);
        assert(backlight_apply_brightness.calls == brightness_writes);
        assert(screensaver_idle_check.calls == 0);
      }
    }
  }
  // Companion sleep must survive the boundary without a new Mac state event.
  for (bool fast_first : {false, true}) {
    for (bool locked : {false, true}) {
      reset(); screensaver_mode.state = "companion";
      mac_connected = locked; screen_lock_mac_locked() = locked;
      controller.request(DisplayRequestSource::IDLE_TIMER, DisplayMode::DISPLAY_OFF);
      clock_time.hour = 9;
      (fast_first ? display_mode_reconcile : screen_schedule_check).execute();
      (fast_first ? screen_schedule_check : display_mode_reconcile).execute(); advance(1000);
      assert(controller.current_mode_is(DisplayMode::DISPLAY_OFF));
      assert(controller.target_source_is(DisplayRequestSource::IDLE_TIMER));
      assert(screensaver_idle_check.calls == 0);
    }
    reset(); screensaver_mode.state = "companion"; clock_time.hour = 9;
    (fast_first ? display_mode_reconcile : screen_schedule_check).execute();
    (fast_first ? screen_schedule_check : display_mode_reconcile).execute(); advance(1000);
    assert(controller.current_mode_is(DisplayMode::ACTIVE));
  }
  // A new timeout applies to the elapsed temporary wake. It does not give
  // the display a fresh timeout starting at the settings edit.
  reset(DisplayMode::DISPLAY_OFF);
  manual_wake_ms = millis();
  schedule_wake_timeout.state = 3600;
  screen_schedule_wake_timeout_check.execute();
  advance(2000);
  schedule_wake_timeout.state = 10;
  screen_schedule_check.execute();
  screen_schedule_wake_timeout_check.execute();
  advance(7999);
  assert(manual_wake_ms != 0);
  advance(1);
  assert(manual_wake_ms == 0);

  // A disabled screensaver lets the panel wake when the night schedule ends.
  reset(); clock_time.hour = 7;
  screensaver_mode.state = "disabled";
  display_mode_reconcile.execute(); advance(500);
  assert(controller.current_mode_is(DisplayMode::ACTIVE));
  // Disabling the schedule is a deliberate normal wake, not an idle handoff.
  for (bool fast_first : {false, true}) {
    reset(); schedule_enabled.state = false;
    (fast_first ? display_mode_reconcile : screen_schedule_check).execute();
    (fast_first ? screen_schedule_check : display_mode_reconcile).execute(); advance(1000);
    assert(controller.current_mode_is(DisplayMode::ACTIVE));
    assert(!controller.request_active(DisplayRequestSource::IDLE_TIMER));
  }
  // A tap after the boundary must wake even before stale schedule ownership clears.
  for (bool fast_first : {false, true}) {
    reset(); clock_time.hour = 12; screensaver_wake.running = true;
    (fast_first ? display_mode_reconcile : screen_schedule_check).execute();
    (fast_first ? screen_schedule_check : display_mode_reconcile).execute(); advance(1000);
    assert(controller.current_mode_is(DisplayMode::ACTIVE));
    assert(!controller.request_active(DisplayRequestSource::IDLE_TIMER));
    screensaver_wake.running = false;
  }
  // Losing time must stay fail-dark without creating a stale daytime idle request.
  for (bool fast_first : {false, true}) {
    reset(); clock_time.hour = 12; clock_time.valid = false;
    (fast_first ? display_mode_reconcile : screen_schedule_check).execute();
    (fast_first ? screen_schedule_check : display_mode_reconcile).execute(); advance(1000);
    assert(controller.target_source_is(DisplayRequestSource::BOOT_GUARD));
    assert(!controller.request_active(DisplayRequestSource::IDLE_TIMER));
    assert(!controller.request_active(DisplayRequestSource::PRESENCE_SENSOR));
    clock_time.valid = true;
    display_mode_reconcile.execute(); screen_schedule_check.execute(); advance(1000);
    assert(controller.current_mode_is(DisplayMode::ACTIVE));
    assert(screensaver_idle_check.is_running());
  }
  // Manual sleep is never cleared by either order at the schedule boundary.
  for (bool fast_first : {false, true}) {
    reset(); controller.request(DisplayRequestSource::MANUAL_SLEEP, DisplayMode::DISPLAY_OFF);
    controller.complete_transition(controller.resolve()); clock_time.hour = 7;
    (fast_first ? display_mode_reconcile : screen_schedule_check).execute();
    (fast_first ? screen_schedule_check : display_mode_reconcile).execute(); advance(1000);
    assert(controller.target_source_is(DisplayRequestSource::MANUAL_SLEEP));
    assert(screensaver_idle_check.calls == 0);
  }
  // First-time setup owns ACTIVE indefinitely; a completion must not arm idle.
  reset(); clock_time.hour = 12; button_order.state.clear(); active_page = setup.obj;
  display_mode_reconcile.execute(); advance(301000);
  assert(controller.target_source_is(DisplayRequestSource::ONBOARDING));
  assert(screensaver_idle_check.calls == 0);
  button_order.state = "1";
  // A new panel without a saved document still starts with the time schedule.
  reset(); controller = {};
  const ScreenSchedulePreferences defaults;
  schedule_enabled.state = defaults.enabled;
  schedule_on_hour.state = defaults.on_hour;
  schedule_off_hour.state = defaults.off_hour;
  clock_time.valid = false;
  screen_schedule_boot_guard.execute();
  assert(controller.target_mode_is(DisplayMode::DISPLAY_OFF));
  assert(controller.target_source_is(DisplayRequestSource::BOOT_GUARD));
  clock_time.valid = true;
  // Night boot must not start a normal idle countdown.
  for (auto mode : {DisplayMode::CLOCK, DisplayMode::DISPLAY_OFF}) {
    reset(mode); display_active_finalize.execute(); advance(100);
    assert(screensaver_idle_check.calls == 0);
  }
  // A newer sleep decision during page settling must suppress finalization.
  reset(); clock_time.hour = 7; screensaver_mode.state = "disabled";
  display_mode_reconcile.execute(); advance(310);
  controller.request(DisplayRequestSource::MANUAL_SLEEP, DisplayMode::DISPLAY_OFF);
  display_mode_reconcile.execute(); advance(100);
  assert(screensaver_idle_check.calls == 0);
  // Boot navigation still finalizes even when no ACTIVE transition is needed.
  reset(); controller = {}; clock_time.hour = 12;
  display_active_finalize.execute(); advance(100);
  assert(screensaver_idle_check.is_running());
  // Ending an ACTIVE schedule while a subpage is selected still restarts the
  // screensaver countdown, even when the home-page timeout is disabled.
  reset(); clock_time.hour = 12;
  controller.clear(DisplayRequestSource::SCREEN_SCHEDULE);
  controller.request(DisplayRequestSource::USER_WAKE, DisplayMode::ACTIVE);
  controller.complete_transition(controller.resolve());
  active_page = actions.obj;
  display_active_finalize.execute(); advance(100);
  assert(screensaver_idle_check.is_running());
  std::cout << "Schedule callback orders, Mac display sleep and wake, idle expiry, manual sleep, stale finalization and boot passed\n";
}
