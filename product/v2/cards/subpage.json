{
  "label": "Subpage",
  "allowInSubpage": true,
  "domains": [],
  "options": [
    { "name": "generated_card_exclusions", "label": "Customized automatic cards", "kind": "text", "omitDefault": true, "hidden": true, "docsHidden": true },
    {
      "name": "subpage_connector", "label": "Subpage Connector", "kind": "choice",
      "values": ["", "mac_companion"],
      "defaultValue": "", "omitDefault": true
    },
    {
      "name": "subpage_kind", "label": "Subpage Type", "kind": "choice",
      "values": ["", "switch", "lights", "climate", "presence", "media", "alarm", "cover", "garage", "gate", "lock", "vacuum", "lawn_mower", "weather", "sensor", "image", "companion_stat", "apple_shortcuts", "obs_transitions", "obs_sources", "obs_audio", "obs_scenes", "obs_studio_control"],
      "defaultValue": "", "omitDefault": true
    },
    { "name": "apple_shortcuts_hidden", "label": "Hidden Apple Shortcuts", "kind": "text", "omitDefault": true, "hidden": true, "docsHidden": true },
    { "name": "obs_transition_order", "label": "Transition visibility and order", "kind": "text", "omitDefault": true },
    { "name": "obs_source_order", "label": "Source visibility and order", "kind": "text", "omitDefault": true },
    { "name": "obs_audio_order", "label": "Audio slider visibility and order", "kind": "text", "omitDefault": true },
    { "name": "obs_scene_order", "label": "Scene visibility and order", "kind": "text", "omitDefault": true },
    { "name": "large_numbers", "label": "Large State Numbers", "kind": "flag", "omitDefault": true }
  ],
  "normalization": {
    "fields": {
      "entity": { "policy": "keep" },
      "label": { "policy": "hook", "hook": "normalize_subpage_fields" },
      "icon": { "policy": "hook", "hook": "normalize_subpage_fields" },
      "icon_on": { "policy": "hook", "hook": "normalize_subpage_fields" },
      "sensor": { "policy": "hook", "hook": "normalize_subpage_fields" },
      "unit": { "policy": "hook", "hook": "normalize_subpage_fields" },
      "type": { "policy": "default", "value": "subpage" },
      "precision": { "policy": "hook", "hook": "normalize_subpage_fields" },
      "options": { "policy": "hook", "hook": "normalize_subpage_options" }
    },
    "unknownOptions": "drop",
    "canonicalOptionOrder": ["subpage_connector", "subpage_kind", "apple_shortcuts_hidden", "obs_transition_order", "obs_source_order", "obs_audio_order", "obs_scene_order", "generated_card_exclusions", "large_numbers"],
    "optionHook": "normalize_subpage_options"
  },
  "default": {
    "entity": "", "label": "", "icon": "Auto", "icon_on": "Auto",
    "sensor": "", "unit": "", "type": "subpage", "precision": "", "options": ""
  }
}
