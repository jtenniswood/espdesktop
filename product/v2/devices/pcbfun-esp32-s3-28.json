      "grid": {
        "top": 12,
        "compactTop": 1,
        "left": 1.5,
        "right": 1.5,
        "bottom": 1,
        "gap": 2,
        "fr": "1fr"
      },
      "btn": {
        "radius": 4,
        "padding": 2.5,
        "iconSize": 10,
        "labelSize": 4,
        "mediaTitleSize": 5.5,
        "coverArtTitleSize": 8,
        "coverArtArtistSize": 5,
        "labelLines": 2,
        "labelLinesDouble": 3,
        "smallTextSize": 3.5
