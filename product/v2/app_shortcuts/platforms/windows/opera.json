    {"id": "10", "label": "Go Forward", "shortcut": "option+right", "icon": "Chevron Right"},
    {"id": "11", "label": "Private Window", "shortcut": "control+shift+n", "icon": "Keyboard"},
    {"id": "12", "label": "History", "shortcut": "control+h", "icon": "History"},
    {"id": "13", "label": "Downloads", "shortcut": "control+j", "icon": "Keyboard"},
