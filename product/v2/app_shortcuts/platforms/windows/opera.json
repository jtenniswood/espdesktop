    {"id": "18", "label": "Print page", "shortcut": "control+p", "icon": "Printer"},
    {"id": "19", "label": "Quit Opera", "shortcut": "control+shift+x", "icon": "Keyboard"},
    {"id": "20", "label": "Save a page locally", "shortcut": "control+s", "icon": "Save"},
    {"id": "21", "label": "Open help", "shortcut": "f1", "icon": "Keyboard"},
