{
  "label": "Outlook (classic)",
  "executables": [
    "outlook.exe"
  ],
  "targets": [
    "microsoft.office.outlook.exe.15"
  ],
  "sources": [
    "https://support.microsoft.com/en-us/accessibility/outlook/keyboard-shortcuts-for-outlook"
  ],
  "note": "For classic Outlook desktop. New Outlook has its own keyboard shortcuts.",
  "shortcuts": [
    {"id": "0", "label": "New Message", "shortcut": "control+shift+m", "icon": "Chat"},
    {"id": "1", "label": "Send message", "shortcut": "option+s", "icon": "Send"},
    {"id": "2", "label": "Search Mail", "shortcut": "control+e", "icon": "Find Tab"},
    {"id": "3", "label": "Reply", "shortcut": "control+r", "icon": "Keyboard"},
    {"id": "4", "label": "Reply All", "shortcut": "control+shift+r", "icon": "Reply"},
    {"id": "5", "label": "Forward message", "shortcut": "control+f", "icon": "Chat"},
    {"id": "6", "label": "Open Mail", "shortcut": "control+1", "icon": "Keyboard"},
    {"id": "7", "label": "Open Calendar", "shortcut": "control+2", "icon": "Calendar"},
    {"id": "8", "label": "New Appointment", "shortcut": "control+shift+a", "icon": "Plus"},
    {"id": "9", "label": "New Task", "shortcut": "control+shift+k", "icon": "Plus"},
    {"id": "10", "label": "Check for New Messages", "shortcut": "f9", "icon": "Plus"},
    {"id": "11", "label": "Open Address Book", "shortcut": "control+shift+b", "icon": "Plus"},
    {"id": "12", "label": "Close a window or a menu", "shortcut": "escape", "icon": "Window Close"},
    {"id": "13", "label": "Delete an item", "shortcut": "forwarddelete", "icon": "Delete"},
    {"id": "14", "label": "Copy an item", "shortcut": "control+c", "icon": "Open File"},
    {"id": "15", "label": "Check for new messages", "shortcut": "control+m", "icon": "Plus"},
    {"id": "16", "label": "Switch to the Copilot view", "shortcut": "control+3", "icon": "Keyboard"},
    {"id": "17", "label": "Switch to the People view", "shortcut": "control+4", "icon": "Keyboard"},
    {"id": "18", "label": "Switch to the To Do", "shortcut": "control+5", "icon": "Keyboard"},
    {"id": "19", "label": "Switch to the Org Explorer pane", "shortcut": "control+6", "icon": "Keyboard"},
    {"id": "20", "label": "Switch to Loop", "shortcut": "control+7", "icon": "Keyboard"},
    {"id": "21", "label": "Open Tasks", "shortcut": "control+8", "icon": "Keyboard"},
    {"id": "22", "label": "Switch to next open message", "shortcut": "control+keyperiod", "icon": "Chevron Right"},
    {"id": "23", "label": "Switch to previous open message", "shortcut": "control+keycomma", "icon": "Chevron Left"},
    {"id": "24", "label": "Move between the ribbon and the calendar", "shortcut": "f6", "icon": "Keyboard"},
    {"id": "25", "label": "Open split buttons", "shortcut": "option+down", "icon": "Keyboard"},
    {"id": "26", "label": "Move between Navigation pane and calendar", "shortcut": "control+tab", "icon": "Keyboard"},
    {"id": "27", "label": "Go to a different folder", "shortcut": "control+y", "icon": "Folder Open Outline"},
    {"id": "28", "label": "Go to the Search box", "shortcut": "f3", "icon": "Search"},
    {"id": "29", "label": "In the Reading pane, go to the previous message", "shortcut": "option+up", "icon": "Chevron Left"},
    {"id": "30", "label": "In the Reading pane, page down through the text", "shortcut": "space", "icon": "Keyboard"},
    {"id": "31", "label": "In the Reading pane, page up through the text", "shortcut": "shift+space", "icon": "Keyboard"},
    {"id": "32", "label": "Collapse or expand a group email message list", "shortcut": "left", "icon": "Chat"},
    {"id": "33", "label": "Open Home tab", "shortcut": "option+h", "icon": "Tab"},
    {"id": "34", "label": "Open File menu", "shortcut": "option+f", "icon": "Folder"},
    {"id": "35", "label": "Open Folder tab", "shortcut": "option+o", "icon": "Tab"},
    {"id": "36", "label": "Open View tab", "shortcut": "option+v", "icon": "Tab"},
    {"id": "37", "label": "Go to the Tell Me search field", "shortcut": "option+q", "icon": "Search"},
    {"id": "38", "label": "Create a contact", "shortcut": "control+shift+c", "icon": "Plus"},
    {"id": "39", "label": "Create a contact group", "shortcut": "control+shift+l", "icon": "Plus"},
    {"id": "40", "label": "Create a fax", "shortcut": "control+shift+x", "icon": "Plus"},
    {"id": "41", "label": "Create a folder", "shortcut": "control+shift+e", "icon": "Plus"},
    {"id": "42", "label": "Post to the selected folder", "shortcut": "control+shift+s", "icon": "Keyboard"},
    {"id": "43", "label": "Post a reply in the selected folder", "shortcut": "control+t", "icon": "Keyboard"},
    {"id": "44", "label": "Create a Search folder", "shortcut": "control+shift+p", "icon": "Folder Search"},
    {"id": "45", "label": "Switch case first letter in a word or line", "shortcut": "shift+f3", "icon": "Keyboard"},
    {"id": "46", "label": "Apply bold formatting", "shortcut": "control+b", "icon": "Keyboard"},
    {"id": "47", "label": "Apply italic formatting", "shortcut": "control+i", "icon": "Keyboard"},
    {"id": "48", "label": "Decrease indent", "shortcut": "control+shift+t", "icon": "Decrease Indent"},
    {"id": "49", "label": "Underline text", "shortcut": "control+u", "icon": "Underline"},
    {"id": "50", "label": "Cut a selection", "shortcut": "control+x", "icon": "Paste"},
    {"id": "51", "label": "Paste the copied or cut selection", "shortcut": "control+v", "icon": "Keyboard"},
    {"id": "52", "label": "Clear the formatting", "shortcut": "control+shift+z", "icon": "Delete"},
    {"id": "53", "label": "Delete the next word", "shortcut": "control+shift+h", "icon": "Chevron Right"},
    {"id": "54", "label": "Insert a hyperlink", "shortcut": "control+k", "icon": "Plus"},
    {"id": "55", "label": "Left-align a paragraph", "shortcut": "control+l", "icon": "Keyboard"},
    {"id": "56", "label": "Remove paragraph formatting", "shortcut": "control+q", "icon": "Delete"},
    {"id": "57", "label": "Use Advanced Find", "shortcut": "control+shift+f", "icon": "Search"}
  ]
}
