    {"id": "52", "label": "Delete character to right of insertion point", "shortcut": "forwarddelete", "icon": "Delete"},
    {"id": "53", "label": "Delete from insertion point to start of word", "shortcut": "control+delete", "icon": "Delete"},
    {"id": "54", "label": "Delete from insertion point to end of word", "shortcut": "control+forwarddelete", "icon": "Delete"},
    {"id": "55", "label": "Bigger text", "shortcut": "control+shift+keyperiod", "icon": "Heading"},
    {"id": "56", "label": "Smaller text", "shortcut": "control+shift+keycomma", "icon": "Heading"},
    {"id": "57", "label": "Precise bigger text", "shortcut": "control+option+shift+keyperiod", "icon": "Heading"}
