{
  "label": "OrcaSlicer",
  "executables": [
    "orca-slicer.exe"
  ],
  "sources": [
    "https://github.com/OrcaSlicer/OrcaSlicer/wiki/keyboard_shortcuts"
  ],
  "note": "Bindings depend on the active Prepare or Preview tab.",
  "shortcuts": [
    {"id": "0", "label": "Slice Plate", "shortcut": "control+r", "icon": "Layers"},
    {"id": "1", "label": "Print Plate", "shortcut": "control+shift+g", "icon": "Printer 3D"},
    {"id": "2", "label": "Import Model", "shortcut": "control+i", "icon": "Import"},
    {"id": "3", "label": "Save Project", "shortcut": "control+s", "icon": "Save"},
    {"id": "4", "label": "Open Project", "shortcut": "control+o", "icon": "Folder Open Outline"},
    {"id": "5", "label": "Arrange Objects", "shortcut": "a", "icon": "Shortcut Command"},
    {"id": "6", "label": "Preferences", "shortcut": "control+p", "icon": "Settings"},
    {"id": "7", "label": "New Project", "shortcut": "control+n", "icon": "New File"},
    {"id": "8", "label": "Save Project as", "shortcut": "control+shift+s", "icon": "Save"},
    {"id": "9", "label": "Publish 3MF", "shortcut": "control+shift+e", "icon": "Shortcut Command"},
    {"id": "10", "label": "Export plate sliced file", "shortcut": "control+g", "icon": "Export"},
    {"id": "11", "label": "Print host upload queue", "shortcut": "control+j", "icon": "Printer"},
    {"id": "12", "label": "Camera view - Default", "shortcut": "control+0", "icon": "Application"},
    {"id": "13", "label": "Camera view - Top", "shortcut": "control+1", "icon": "Application"},
    {"id": "14", "label": "Camera view - Bottom", "shortcut": "control+2", "icon": "Application"},
    {"id": "15", "label": "Camera view - Front", "shortcut": "control+3", "icon": "Application"},
    {"id": "16", "label": "Camera view - Behind", "shortcut": "control+4", "icon": "Application"},
    {"id": "17", "label": "Camera Angle - Left side", "shortcut": "control+5", "icon": "Shortcut Command"},
    {"id": "18", "label": "Camera Angle - Right side", "shortcut": "control+6", "icon": "Shortcut Command"},
    {"id": "19", "label": "Camera view - Current plate", "shortcut": "control+7", "icon": "Application"},
    {"id": "20", "label": "Show object labels in 3D scene", "shortcut": "control+e", "icon": "Vector"},
    {"id": "21", "label": "Show all collision volumes", "shortcut": "control+shift+k", "icon": "Keyboard"},
    {"id": "22", "label": "Search", "shortcut": "control+f", "icon": "Search"},
    {"id": "23", "label": "Open Speed Dial", "shortcut": "space", "icon": "Speed Up"},
    {"id": "24", "label": "Switch to the next main tab", "shortcut": "control+tab", "icon": "Chevron Right"},
    {"id": "25", "label": "Isometric view, fitted to the model", "shortcut": "home", "icon": "Application"},
    {"id": "26", "label": "Show or hide the origin planes", "shortcut": "p", "icon": "Keyboard"},
    {"id": "27", "label": "Section view on or off", "shortcut": "x", "icon": "Application"},
    {"id": "28", "label": "Show or hide the printer bed", "shortcut": "control+shift+b", "icon": "Printer"},
    {"id": "29", "label": "Commit to Plate", "shortcut": "control+shift+p", "icon": "Source Branch"},
    {"id": "30", "label": "Rename the selected feature", "shortcut": "f2", "icon": "Rename"},
    {"id": "31", "label": "Clear the selection", "shortcut": "escape", "icon": "Group Selection"},
    {"id": "32", "label": "Select all objects", "shortcut": "control+a", "icon": "Select All"},
    {"id": "33", "label": "Select all objects on all plates", "shortcut": "control+shift+a", "icon": "Select All"},
    {"id": "34", "label": "Undo", "shortcut": "control+z", "icon": "Undo"},
    {"id": "35", "label": "Redo", "shortcut": "control+y", "icon": "Redo"},
    {"id": "36", "label": "Cut", "shortcut": "control+x", "icon": "Cut"},
    {"id": "37", "label": "Delete All", "shortcut": "control+d", "icon": "Delete"},
    {"id": "38", "label": "Clone Selected", "shortcut": "control+k", "icon": "Shortcut Command"},
    {"id": "39", "label": "Remove instance", "shortcut": "keyminus", "icon": "Delete"},
    {"id": "40", "label": "Toggle printable for object/part", "shortcut": "v", "icon": "Vector"},
    {"id": "41", "label": "Arrange objects on selected plates", "shortcut": "shift+a", "icon": "Shortcut Command"},
    {"id": "42", "label": "Auto orient all/selected objects", "shortcut": "q", "icon": "Shortcut Command"},
    {"id": "43", "label": "Auto orient all objects on current plate", "shortcut": "shift+q", "icon": "Shortcut Command"},
    {"id": "44", "label": "Rotate selection 45 degrees counterclockwise", "shortcut": "pageup", "icon": "Group Selection"},
    {"id": "45", "label": "Rotate selection 45 degrees clockwise", "shortcut": "pagedown", "icon": "Group Selection"}
  ]
}
