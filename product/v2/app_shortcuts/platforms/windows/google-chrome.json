    {"id": "31", "label": "Close the window", "shortcut": "control+shift+w", "icon": "Window Close"},
    {"id": "32", "label": "Move tabs right or left", "shortcut": "control+shift+pageup", "icon": "Shortcut Command"},
    {"id": "33", "label": "Open Chrome menu", "shortcut": "option+f", "icon": "Keyboard"},
