    {"id": "39", "label": "Open feedback form", "shortcut": "option+shift+i", "icon": "Open File"},
    {"id": "40", "label": "Search from anywhere on the page", "shortcut": "control+k", "icon": "Search"},
    {"id": "41", "label": "Move cursor to the address bar", "shortcut": "control+f5", "icon": "Shortcut Command"},
    {"id": "42", "label": "Open options to print the page", "shortcut": "control+p", "icon": "Printer"},
    {"id": "43", "label": "Open options to save the page", "shortcut": "control+s", "icon": "Save"},
    {"id": "44", "label": "Reload the page", "shortcut": "f5", "icon": "Keyboard"},
    {"id": "45", "label": "Reload the page, ignoring cached content", "shortcut": "shift+f5", "icon": "Book"},
    {"id": "46", "label": "Stop the page loading", "shortcut": "escape", "icon": "Stop"},
    {"id": "47", "label": "Browse clickable items moving forward", "shortcut": "tab", "icon": "Arrow Right"},
    {"id": "48", "label": "Browse clickable items moving backward", "shortcut": "shift+tab", "icon": "Skip Previous"},
    {"id": "49", "label": "Display non-editable HTML source code for page", "shortcut": "control+u", "icon": "Code"},
    {"id": "50", "label": "Return everything on the page to default size", "shortcut": "control+0", "icon": "Book"},
    {"id": "51", "label": "Scroll down a webpage, a screen at a time", "shortcut": "space", "icon": "Arrow Down"},
    {"id": "52", "label": "Scroll up a webpage, a screen at a time", "shortcut": "shift+space", "icon": "Arrow Up"},
    {"id": "53", "label": "Go to the top of the page", "shortcut": "home", "icon": "Keyboard"},
    {"id": "54", "label": "Go to the bottom of the page", "shortcut": "end", "icon": "Keyboard"},
    {"id": "55", "label": "Move your cursor to the next word", "shortcut": "control+right", "icon": "Chevron Right"},
    {"id": "56", "label": "Delete the previous word in a text field", "shortcut": "control+delete", "icon": "Delete"}
  ]
