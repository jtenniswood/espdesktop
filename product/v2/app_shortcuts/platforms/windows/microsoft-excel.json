{
  "label": "Microsoft Excel",
  "executables": [
    "excel.exe"
  ],
  "targets": [
    "microsoft.office.excel.exe.15"
  ],
  "sources": [
    "https://support.microsoft.com/en-us/accessibility/excel/keyboard-shortcuts-in-excel"
  ],
  "defaultShortcutIds": [
    "0",
    "1",
    "2",
    "3",
    "4",
    "5"
  ],
  "shortcuts": [
    {"id": "0", "label": "New", "shortcut": "control+n", "icon": "New Window"},
    {"id": "1", "label": "Open", "shortcut": "control+o", "icon": "Folder"},
    {"id": "2", "label": "Save", "shortcut": "control+s", "icon": "Save"},
    {"id": "3", "label": "Print", "shortcut": "control+p", "icon": "Printer"},
    {"id": "4", "label": "Undo", "shortcut": "control+z", "icon": "Undo"},
    {"id": "5", "label": "Redo", "shortcut": "control+y", "icon": "Redo"},
    {"id": "6", "label": "Edit cell", "shortcut": "f2", "icon": "View Grid"},
    {"id": "7", "label": "Format Cells", "shortcut": "control+1", "icon": "Keyboard"},
    {"id": "8", "label": "Insert Function", "shortcut": "shift+f3", "icon": "Keyboard"},
    {"id": "9", "label": "Insert Table", "shortcut": "control+t", "icon": "Notes"},
    {"id": "10", "label": "AutoSum", "shortcut": "option+keyequal", "icon": "Keyboard"},
    {"id": "11", "label": "Paste Special", "shortcut": "control+option+v", "icon": "Paste"},
    {"id": "12", "label": "Fill down", "shortcut": "control+d", "icon": "Palette"},
    {"id": "13", "label": "Fill Right", "shortcut": "control+r", "icon": "Palette"},
    {"id": "14", "label": "Next Worksheet", "shortcut": "control+pagedown", "icon": "Chevron Right"},
    {"id": "15", "label": "Previous Worksheet", "shortcut": "control+pageup", "icon": "Chevron Left"},
    {"id": "16", "label": "New Worksheet", "shortcut": "shift+f11", "icon": "Plus"},
    {"id": "17", "label": "Insert Date", "shortcut": "control+keysemicolon", "icon": "Notes"},
    {"id": "18", "label": "Insert Time", "shortcut": "control+shift+keysemicolon", "icon": "Notes"},
    {"id": "19", "label": "Show Formulas", "shortcut": "control+keybackquote", "icon": "Keyboard"},
    {"id": "20", "label": "Calculate Workbook", "shortcut": "f9", "icon": "Calculator"},
    {"id": "21", "label": "Insert Comment", "shortcut": "control+shift+f2", "icon": "Chat"},
    {"id": "22", "label": "Center Cell Contents", "shortcut": "option+h~a~c", "icon": "Keyboard"},
    {"id": "23", "label": "Delete Column", "shortcut": "option+h~d~c", "icon": "Group Selection"},
    {"id": "24", "label": "Close a workbook", "shortcut": "control+w", "icon": "Save"},
    {"id": "25", "label": "Go to the Home tab", "shortcut": "option+h", "icon": "Tab"},
    {"id": "26", "label": "Copy selection", "shortcut": "control+c", "icon": "Copy"},
    {"id": "27", "label": "Paste selection", "shortcut": "control+v", "icon": "Paste"},
    {"id": "28", "label": "Remove cell contents", "shortcut": "forwarddelete", "icon": "Delete"},
    {"id": "29", "label": "Cut selection", "shortcut": "control+x", "icon": "Cut"},
    {"id": "30", "label": "Go to the Insert tab", "shortcut": "option+n", "icon": "Tab"},
    {"id": "31", "label": "Apply bold formatting", "shortcut": "control+b", "icon": "Bold"},
    {"id": "32", "label": "Go to the Page Layout tab", "shortcut": "option+p", "icon": "Tab"},
    {"id": "33", "label": "Go to the Data tab", "shortcut": "option+a", "icon": "Tab"},
    {"id": "34", "label": "Go to the View tab", "shortcut": "option+w", "icon": "Tab"},
    {"id": "35", "label": "Go to the Formula tab", "shortcut": "option+m", "icon": "Tab"},
    {"id": "36", "label": "Hide the selected rows", "shortcut": "control+9", "icon": "Keyboard"},
    {"id": "37", "label": "Hide the selected columns", "shortcut": "control+0", "icon": "Keyboard"},
    {"id": "38", "label": "Move focus to commands on ribbon or add-in pane", "shortcut": "tab", "icon": "Plus"},
    {"id": "39", "label": "Activate a selected button", "shortcut": "space", "icon": "Keyboard"},
    {"id": "40", "label": "Open list for a selected command", "shortcut": "down", "icon": "Keyboard"},
    {"id": "41", "label": "Open menu for a selected button", "shortcut": "option+down", "icon": "Keyboard"},
    {"id": "42", "label": "Expand or collapse the ribbon", "shortcut": "control+f1", "icon": "Keyboard"},
    {"id": "43", "label": "Move from one group of controls to another", "shortcut": "control+left", "icon": "Keyboard"},
    {"id": "44", "label": "Move one cell up in a worksheet", "shortcut": "up", "icon": "Keyboard"},
    {"id": "45", "label": "Move one cell left in a worksheet", "shortcut": "left", "icon": "Keyboard"},
    {"id": "46", "label": "Move one cell right in a worksheet", "shortcut": "right", "icon": "Keyboard"},
    {"id": "47", "label": "Move to the beginning of a worksheet", "shortcut": "control+home", "icon": "Keyboard"},
    {"id": "48", "label": "Move one screen down in a worksheet", "shortcut": "pagedown", "icon": "Keyboard"},
    {"id": "49", "label": "Move one screen to the right in a worksheet", "shortcut": "option+pagedown", "icon": "Keyboard"},
    {"id": "50", "label": "Move one screen up in a worksheet", "shortcut": "pageup", "icon": "Keyboard"},
    {"id": "51", "label": "Move one screen to the left in a worksheet", "shortcut": "option+pageup", "icon": "Keyboard"},
    {"id": "52", "label": "Format fonts in the Format Cells dialog", "shortcut": "control+shift+f", "icon": "Keyboard"},
    {"id": "53", "label": "Italicize text or remove italic formatting", "shortcut": "control+i", "icon": "Italic"},
    {"id": "54", "label": "Underline text or remove underline", "shortcut": "control+u", "icon": "Delete"},
    {"id": "55", "label": "Apply or remove strikethrough formatting", "shortcut": "control+5", "icon": "Strikethrough"},
    {"id": "56", "label": "Display or hide the outline symbols", "shortcut": "control+8", "icon": "Play Pause"},
    {"id": "57", "label": "Open Insert hyperlink dialog", "shortcut": "control+k", "icon": "Plus"}
  ]
}
