{
  "label": "ChatGPT Desktop",
  "executables": [
    "codex.exe"
  ],
  "sources": [
    "https://learn.chatgpt.com/docs/app/commands",
    "https://learn.chatgpt.com/docs/app/windows"
  ],
  "note": "For the current ChatGPT desktop app. Commands depend on whether Chat, Work, or Codex is active.",
  "shortcuts": [
    {"id": "0", "label": "New Chat", "shortcut": "control+n", "icon": "Chat Plus"},
    {"id": "1", "label": "Command Menu", "shortcut": "control+shift+p", "icon": "Shortcut Command"},
    {"id": "2", "label": "Find in Chat", "shortcut": "control+f", "icon": "Search"},
    {"id": "3", "label": "Next Chat or Tab", "shortcut": "control+tab", "icon": "Chevron Right"},
    {"id": "4", "label": "Previous Chat or Tab", "shortcut": "control+shift+tab", "icon": "Chevron Left"},
    {"id": "5", "label": "Toggle Sidebar", "shortcut": "control+b", "icon": "Dock Left"},
    {"id": "6", "label": "Open Settings", "shortcut": "control+keycomma", "icon": "Settings"},
    {"id": "7", "label": "Full Screen", "shortcut": "f11", "icon": "Full Screen"},
    {"id": "8", "label": "Open keyboard shortcuts", "shortcut": "control+keyslash", "icon": "Keyboard"},
    {"id": "9", "label": "Open folder", "shortcut": "control+o", "icon": "Folder"},
