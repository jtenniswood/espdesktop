{
  "label": "Microsoft PowerPoint",
  "executables": [
    "powerpnt.exe"
  ],
  "targets": [
    "microsoft.office.powerpnt.exe.15"
  ],
  "sources": [
    "https://support.microsoft.com/en-us/accessibility/powerpoint/use-keyboard-shortcuts-to-create-powerpoint-presentations",
    "https://support.microsoft.com/en-us/accessibility/powerpoint/use-keyboard-shortcuts-to-deliver-powerpoint-presentations"
  ],
  "shortcuts": [
    {"id": "0", "label": "New", "shortcut": "control+n", "icon": "New Window"},
    {"id": "1", "label": "Open", "shortcut": "control+o", "icon": "Folder"},
    {"id": "2", "label": "Save", "shortcut": "control+s", "icon": "Save"},
    {"id": "3", "label": "Print", "shortcut": "control+p", "icon": "Printer"},
    {"id": "4", "label": "Undo", "shortcut": "control+z", "icon": "Undo"},
    {"id": "5", "label": "Redo", "shortcut": "control+y", "icon": "Redo"},
    {"id": "6", "label": "New Slide", "shortcut": "control+m", "icon": "New File"},
    {"id": "7", "label": "Duplicate Slide", "shortcut": "control+shift+d", "icon": "Copy"},
    {"id": "8", "label": "Duplicate Selected Object", "shortcut": "control+d", "icon": "Duplicate"},
    {"id": "9", "label": "Start Slide Show", "shortcut": "f5", "icon": "Keyboard"},
    {"id": "10", "label": "Start Show from Slide", "shortcut": "shift+f5", "icon": "Keyboard"},
    {"id": "11", "label": "Presenter View", "shortcut": "option+f5", "icon": "Run"},
    {"id": "12", "label": "Next Slide", "shortcut": "pagedown", "icon": "New File"},
    {"id": "13", "label": "Previous Slide", "shortcut": "pageup", "icon": "Chevron Left"},
    {"id": "14", "label": "End Show", "shortcut": "escape", "icon": "Slideshow"},
    {"id": "15", "label": "Black Out Slide Show", "shortcut": "b", "icon": "Keyboard", "note": "During a slide show."},
    {"id": "16", "label": "White Out Slide Show", "shortcut": "w", "icon": "Keyboard", "note": "During a slide show."},
    {"id": "17", "label": "Group Objects", "shortcut": "control+g", "icon": "Keyboard"},
    {"id": "18", "label": "Ungroup Objects", "shortcut": "control+shift+g", "icon": "Keyboard"},
    {"id": "19", "label": "Insert Link", "shortcut": "control+k", "icon": "Plus"},
    {"id": "20", "label": "Insert Comment", "shortcut": "control+option+m", "icon": "Keyboard"},
    {"id": "21", "label": "Apply bold formatting to the selected text", "shortcut": "control+b", "icon": "Keyboard"},
    {"id": "22", "label": "Open Font dialog", "shortcut": "control+t", "icon": "Format Size"},
    {"id": "23", "label": "Cut selected text, object, or slide", "shortcut": "control+x", "icon": "Keyboard"},
    {"id": "24", "label": "Copy selected text, object, or slide", "shortcut": "control+c", "icon": "Keyboard"},
    {"id": "25", "label": "Paste cut or copied text, object, or slide", "shortcut": "control+v", "icon": "Keyboard"},
    {"id": "26", "label": "Zoom to fit", "shortcut": "control+option+o", "icon": "Keyboard"},
    {"id": "27", "label": "Copy formatting object or text", "shortcut": "control+shift+c", "icon": "Keyboard"},
    {"id": "28", "label": "Paste copied formatting to object or text", "shortcut": "control+shift+v", "icon": "Keyboard"},
    {"id": "29", "label": "Open Paste Special dialog", "shortcut": "control+option+v", "icon": "Paste"},
    {"id": "30", "label": "Select all objects on a slide", "shortcut": "control+a", "icon": "Keyboard"},
    {"id": "31", "label": "Regroup the selected objects", "shortcut": "control+shift+j", "icon": "Duplicate"},
    {"id": "32", "label": "Rotate the selected object clockwise 15 degrees", "shortcut": "option+right", "icon": "Keyboard"},
    {"id": "33", "label": "Play or pause media", "shortcut": "control+space", "icon": "Play Pause"},
    {"id": "34", "label": "Edit a linked or embedded object", "shortcut": "shift+f10", "icon": "Keyboard"},
    {"id": "35", "label": "Select one character to the right", "shortcut": "shift+right", "icon": "Keyboard"},
    {"id": "36", "label": "Select one character to the left", "shortcut": "shift+left", "icon": "Keyboard"},
    {"id": "37", "label": "Select to the end of a word", "shortcut": "control+shift+right", "icon": "Keyboard"},
    {"id": "38", "label": "Select to the beginning of a word", "shortcut": "control+shift+left", "icon": "Keyboard"},
    {"id": "39", "label": "Select from insertion point to end paragraph", "shortcut": "control+shift+down", "icon": "Keyboard"},
    {"id": "40", "label": "Select text within an object", "shortcut": "enter", "icon": "Keyboard"},
    {"id": "41", "label": "Invoke Copilot options for rewriting textbox", "shortcut": "shift+f8", "icon": "Settings"},
    {"id": "42", "label": "Delete one character to the left", "shortcut": "delete", "icon": "Delete"},
    {"id": "43", "label": "Delete one word to the left", "shortcut": "control+delete", "icon": "Delete"},
    {"id": "44", "label": "Delete one character to the right", "shortcut": "forwarddelete", "icon": "Delete"},
    {"id": "45", "label": "Delete one word to the right", "shortcut": "control+forwarddelete", "icon": "Delete"},
    {"id": "46", "label": "Move one character to the left", "shortcut": "left", "icon": "Keyboard"},
    {"id": "47", "label": "Move one character to the right", "shortcut": "right", "icon": "Keyboard"},
    {"id": "48", "label": "Move one line up", "shortcut": "up", "icon": "Keyboard"},
    {"id": "49", "label": "Move one line down", "shortcut": "down", "icon": "Keyboard"},
    {"id": "50", "label": "Move one word to the left", "shortcut": "control+left", "icon": "Keyboard"},
    {"id": "51", "label": "Move one word to the right", "shortcut": "control+right", "icon": "Keyboard"},
    {"id": "52", "label": "Move to the end of a line", "shortcut": "end", "icon": "Keyboard"},
    {"id": "53", "label": "Move to the beginning of a line", "shortcut": "home", "icon": "Keyboard"},
    {"id": "54", "label": "Move up one paragraph", "shortcut": "control+up", "icon": "Keyboard"},
    {"id": "55", "label": "Move down one paragraph", "shortcut": "control+down", "icon": "Keyboard"},
    {"id": "56", "label": "Move to the end of a text box", "shortcut": "control+end", "icon": "Keyboard"},
    {"id": "57", "label": "Center a paragraph", "shortcut": "control+e", "icon": "Keyboard"}
  ]
}
