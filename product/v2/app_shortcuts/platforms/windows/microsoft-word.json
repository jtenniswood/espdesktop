{
  "label": "Microsoft Word",
  "executables": [
    "winword.exe"
  ],
  "targets": [
    "microsoft.office.winword.exe.15"
  ],
  "sources": [
    "https://support.microsoft.com/en-us/accessibility/word/keyboard-shortcuts-in-word"
  ],
  "shortcuts": [
    {"id": "0", "label": "New", "shortcut": "control+n", "icon": "New Window"},
    {"id": "1", "label": "Open", "shortcut": "control+o", "icon": "Folder"},
    {"id": "2", "label": "Save", "shortcut": "control+s", "icon": "Save"},
    {"id": "3", "label": "Print", "shortcut": "control+p", "icon": "Printer"},
    {"id": "4", "label": "Undo", "shortcut": "control+z", "icon": "Undo"},
    {"id": "5", "label": "Redo", "shortcut": "control+y", "icon": "Redo"},
    {"id": "6", "label": "Find", "shortcut": "control+f", "icon": "Search"},
    {"id": "7", "label": "Replace", "shortcut": "control+h", "icon": "Find Replace"},
    {"id": "8", "label": "Bold", "shortcut": "control+b", "icon": "Keyboard"},
    {"id": "9", "label": "Italic", "shortcut": "control+i", "icon": "Keyboard"},
    {"id": "10", "label": "Underline", "shortcut": "control+u", "icon": "Underline"},
    {"id": "11", "label": "Paste text only", "shortcut": "control+shift+v", "icon": "Paste"},
    {"id": "12", "label": "Insert Link", "shortcut": "control+k", "icon": "Code"},
    {"id": "13", "label": "Insert page break", "shortcut": "control+enter", "icon": "Book"},
    {"id": "14", "label": "Align Left", "shortcut": "control+l", "icon": "Keyboard"},
    {"id": "15", "label": "Center Text", "shortcut": "control+e", "icon": "Keyboard"},
    {"id": "16", "label": "Align Right", "shortcut": "control+r", "icon": "Keyboard"},
    {"id": "17", "label": "Justify Text", "shortcut": "control+j", "icon": "Keyboard"},
    {"id": "18", "label": "New Comment", "shortcut": "control+option+m", "icon": "Chat"},
    {"id": "19", "label": "Spelling and Grammar", "shortcut": "f7", "icon": "Keyboard"},
    {"id": "20", "label": "Save As", "shortcut": "f12", "icon": "Save"},
    {"id": "21", "label": "Go to Start of Document", "shortcut": "control+home", "icon": "Keyboard"},
    {"id": "22", "label": "Go to End of Document", "shortcut": "control+end", "icon": "Open File"},
    {"id": "23", "label": "Increase font size", "shortcut": "control+keybracketright", "icon": "Zoom In"},
    {"id": "24", "label": "Decrease font size", "shortcut": "control+keybracketleft", "icon": "Zoom Out"},
    {"id": "25", "label": "Close the document", "shortcut": "control+w", "icon": "Open File"},
    {"id": "26", "label": "Cut the selected content to the Clipboard", "shortcut": "control+x", "icon": "Cut"},
    {"id": "27", "label": "Copy the selected content to the Clipboard", "shortcut": "control+c", "icon": "Copy"},
    {"id": "28", "label": "Paste the contents of the Clipboard", "shortcut": "control+v", "icon": "Paste"},
    {"id": "29", "label": "Select all document content", "shortcut": "control+a", "icon": "Select All"},
    {"id": "30", "label": "Cancel a command", "shortcut": "escape", "icon": "Keyboard"},
    {"id": "31", "label": "Return back to 100% zoom", "shortcut": "control+0", "icon": "Fit to Screen"},
    {"id": "32", "label": "Split the document window", "shortcut": "control+option+s", "icon": "Keyboard"},
    {"id": "33", "label": "Remove the document window split", "shortcut": "option+shift+c", "icon": "Delete"},
    {"id": "34", "label": "Move the focus to commands on the ribbon", "shortcut": "tab", "icon": "Keyboard"},
    {"id": "35", "label": "Move between command groupings on the ribbon", "shortcut": "control+left", "icon": "Keyboard"},
    {"id": "36", "label": "Activate the selected button", "shortcut": "space", "icon": "Keyboard"},
    {"id": "37", "label": "Open list for the selected command", "shortcut": "down", "icon": "Keyboard"},
    {"id": "38", "label": "Open menu for the selected button", "shortcut": "option+down", "icon": "Keyboard"},
    {"id": "39", "label": "Expand or collapse the ribbon", "shortcut": "control+f1", "icon": "Keyboard"},
    {"id": "40", "label": "Move the cursor one word to the right", "shortcut": "control+right", "icon": "Arrow Right"},
    {"id": "41", "label": "Move the cursor up by one paragraph", "shortcut": "control+up", "icon": "Arrow Up"},
    {"id": "42", "label": "Move the cursor down by one paragraph", "shortcut": "control+down", "icon": "Arrow Down"},
    {"id": "43", "label": "Move the cursor to the end of the line", "shortcut": "end", "icon": "Code"},
    {"id": "44", "label": "Move the cursor to the beginning the line", "shortcut": "home", "icon": "Code"},
    {"id": "45", "label": "Move the cursor to the top of the screen", "shortcut": "control+option+pageup", "icon": "Keyboard"},
    {"id": "46", "label": "Move the cursor to the bottom of the screen", "shortcut": "control+option+pagedown", "icon": "Keyboard"},
    {"id": "47", "label": "Move the cursor to the top of the next page", "shortcut": "control+pagedown", "icon": "Page Next"},
    {"id": "48", "label": "Move the cursor to the top of the previous page", "shortcut": "control+pageup", "icon": "Page Previous"},
    {"id": "49", "label": "Move cursor to location previous revision", "shortcut": "shift+f5", "icon": "Chevron Left"},
    {"id": "50", "label": "Switch to print preview", "shortcut": "control+option+i", "icon": "Printer"},
    {"id": "51", "label": "Move by one preview page when zoomed out", "shortcut": "pageup", "icon": "Keyboard"},
    {"id": "52", "label": "Select word to the left", "shortcut": "control+shift+left", "icon": "Group Selection"},
    {"id": "53", "label": "Select word to the right", "shortcut": "control+shift+right", "icon": "Group Selection"},
    {"id": "54", "label": "Select from position to beginning line", "shortcut": "shift+home", "icon": "Keyboard"},
    {"id": "55", "label": "Select from the position to the end of the line", "shortcut": "shift+end", "icon": "Keyboard"},
    {"id": "56", "label": "Select from position to beginning paragraph", "shortcut": "control+shift+up", "icon": "Keyboard"},
    {"id": "57", "label": "Select from position to end paragraph", "shortcut": "control+shift+down", "icon": "Keyboard"}
  ]
}
