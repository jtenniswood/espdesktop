{
  "label": "Microsoft OneNote",
  "executables": [
    "onenote.exe"
  ],
  "sources": [
    "https://support.microsoft.com/en-us/accessibility/onenote/keyboard-shortcuts-in-onenote"
  ],
  "note": "These bindings apply to the desktop edition.",
  "shortcuts": [
    {"id": "0", "label": "New Page", "shortcut": "control+n", "icon": "New Window"},
    {"id": "1", "label": "New Section", "shortcut": "control+t", "icon": "New Window"},
    {"id": "2", "label": "Search Notebooks", "shortcut": "control+e", "icon": "Search"},
    {"id": "3", "label": "Find on Page", "shortcut": "control+f", "icon": "Search"},
    {"id": "4", "label": "Toggle Full Page View", "shortcut": "f11", "icon": "Keyboard"},
    {"id": "5", "label": "Insert Link", "shortcut": "control+k", "icon": "Keyboard"},
    {"id": "6", "label": "To Do Tag", "shortcut": "control+1", "icon": "Keyboard"}
  ]
}
