{
  "label": "1Password",
  "executables": [
    "1password.exe"
  ],
  "sources": [
    "https://support.1password.com/keyboard-shortcuts/"
  ],
  "note": "Item shortcuts apply inside the 1Password desktop app. Browser extension shortcuts are separate.",
  "shortcuts": [
    {"id": "0", "label": "Search Items", "shortcut": "control+f", "icon": "Search"},
    {"id": "1", "label": "Find in List", "shortcut": "control+option+f", "icon": "Search"},
    {"id": "2", "label": "New Item", "shortcut": "control+n", "icon": "Plus"},
    {"id": "3", "label": "Edit item", "shortcut": "control+e", "icon": "Shortcut Command"},
    {"id": "4", "label": "Save Item", "shortcut": "control+s", "icon": "Save"},
    {"id": "5", "label": "Lock 1Password", "shortcut": "control+shift+l", "icon": "Keyboard"},
    {"id": "6", "label": "Quick Access", "shortcut": "control+shift+space", "icon": "Open File"},
    {"id": "7", "label": "Open Settings", "shortcut": "control+keycomma", "icon": "Settings"},
    {"id": "8", "label": "Copy Username", "shortcut": "control+c", "icon": "Account"},
    {"id": "9", "label": "Copy Password", "shortcut": "control+shift+c", "icon": "Key"},
    {"id": "10", "label": "Copy one-time password", "shortcut": "control+option+c", "icon": "Copy"},
    {"id": "11", "label": "Reveal or conceal secure fields", "shortcut": "control+r", "icon": "Shortcut Command"},
    {"id": "12", "label": "Archive Selected Item", "shortcut": "forwarddelete", "icon": "Archive"},
    {"id": "13", "label": "Back", "shortcut": "option+left", "icon": "Arrow Left"},
    {"id": "14", "label": "Forward", "shortcut": "option+right", "icon": "Arrow Right"},
    {"id": "15", "label": "Toggle Sidebar", "shortcut": "control+shift+d", "icon": "Keyboard"}
  ]
}
