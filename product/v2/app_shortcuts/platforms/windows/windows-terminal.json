    {"id": "2", "label": "Command Palette", "shortcut": "control+shift+p", "icon": "Keyboard"},
    {"id": "3", "label": "Find", "shortcut": "control+shift+f", "icon": "Search"},
    {"id": "4", "label": "Open Settings", "shortcut": "control+keycomma", "icon": "Folder"}
