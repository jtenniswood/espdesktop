{
  "label": "Visual Studio Code",
  "executables": [
    "code.exe"
  ],
  "targets": [
    "microsoft.visualstudiocode"
  ],
  "sources": [
    "https://code.visualstudio.com/docs/reference/default-keybindings"
  ],
  "note": "These are default bindings. Several actions require an editor, search field, or language service to be active.",
  "defaultShortcutIds": [
    "0",
    "1",
    "2",
    "3",
    "4",
    "5"
  ],
  "shortcuts": [
    {"id": "0", "label": "Command Palette", "shortcut": "control+shift+p", "icon": "Shortcut Command"},
    {"id": "1", "label": "Quick Open", "shortcut": "control+p", "icon": "Search"},
    {"id": "2", "label": "Find in Files", "shortcut": "control+shift+f", "icon": "Search"},
    {"id": "3", "label": "Save", "shortcut": "control+s", "icon": "Save"},
    {"id": "4", "label": "Terminal", "shortcut": "control+keybackquote", "icon": "Terminal"},
    {"id": "5", "label": "Explorer", "shortcut": "control+shift+e", "icon": "Folder"},
    {"id": "6", "label": "Toggle Line Comment", "shortcut": "control+keyslash", "icon": "Code"},
    {"id": "7", "label": "Rename Symbol", "shortcut": "f2", "icon": "Rename"},
    {"id": "8", "label": "Format document", "shortcut": "shift+option+f", "icon": "Format Size"},
    {"id": "9", "label": "Keyboard Shortcuts", "shortcut": "control+k~control+s", "icon": "Keyboard"},
    {"id": "10", "label": "Go to Definition", "shortcut": "f12", "icon": "Shortcut Command"},
    {"id": "11", "label": "Quick Fix", "shortcut": "control+keyperiod", "icon": "Shortcut Command"},
    {"id": "12", "label": "Go Back", "shortcut": "option+left", "icon": "Chevron Left"},
    {"id": "13", "label": "Go forward", "shortcut": "option+right", "icon": "Arrow Left"},
    {"id": "14", "label": "Split editor", "shortcut": "control+keybackslash", "icon": "Code"},
    {"id": "15", "label": "Close editor", "shortcut": "control+f4", "icon": "Code"},
    {"id": "16", "label": "Toggle Sidebar", "shortcut": "control+b", "icon": "Keyboard"},
    {"id": "17", "label": "Save All", "shortcut": "control+k~s", "icon": "Save All"},
    {"id": "18", "label": "Replace", "shortcut": "control+h", "icon": "Shortcut Command"},
    {"id": "19", "label": "Redo", "shortcut": "control+y", "icon": "Redo"},
    {"id": "20", "label": "Paste", "shortcut": "control+v", "icon": "Keyboard"},
    {"id": "21", "label": "Delete line", "shortcut": "control+shift+k", "icon": "Delete"},
    {"id": "22", "label": "Insert Line Below", "shortcut": "control+enter", "icon": "Code"},
    {"id": "23", "label": "Insert Line Above", "shortcut": "control+shift+enter", "icon": "Code"},
    {"id": "24", "label": "Move line down", "shortcut": "option+down", "icon": "Arrow Down"},
    {"id": "25", "label": "Move line up", "shortcut": "option+up", "icon": "Arrow Up"},
    {"id": "26", "label": "Copy line down", "shortcut": "shift+option+down", "icon": "Copy"},
    {"id": "27", "label": "Copy line up", "shortcut": "shift+option+up", "icon": "Copy"},
    {"id": "28", "label": "Undo", "shortcut": "control+z", "icon": "Undo"},
    {"id": "29", "label": "Add selection to next Find match", "shortcut": "control+d", "icon": "Group Selection"},
    {"id": "30", "label": "Undo last cursor operation", "shortcut": "control+u", "icon": "Undo"},
    {"id": "31", "label": "Insert cursor at end of each line selected", "shortcut": "shift+option+i", "icon": "Code"},
    {"id": "32", "label": "Select all occurrences of selection", "shortcut": "control+shift+l", "icon": "Select All"},
    {"id": "33", "label": "Select all occurrences of word", "shortcut": "control+f2", "icon": "Select All"},
    {"id": "34", "label": "Select line", "shortcut": "control+l", "icon": "Group Selection"},
    {"id": "35", "label": "Insert cursor below", "shortcut": "control+option+down", "icon": "Plus"},
    {"id": "36", "label": "Insert cursor above", "shortcut": "control+option+up", "icon": "Plus"},
    {"id": "37", "label": "Jump to matching bracket", "shortcut": "control+shift+keybackslash", "icon": "Shortcut Command"},
    {"id": "38", "label": "Indent Line", "shortcut": "control+keybracketright", "icon": "Decrease Indent"},
    {"id": "39", "label": "Go to End of File", "shortcut": "control+end", "icon": "Open File"},
    {"id": "40", "label": "Go to Beginning of File", "shortcut": "control+home", "icon": "Open File"},
    {"id": "41", "label": "Scroll line down", "shortcut": "control+down", "icon": "Arrow Down"},
    {"id": "42", "label": "Scroll line up", "shortcut": "control+up", "icon": "Arrow Down"},
    {"id": "43", "label": "Scroll page down", "shortcut": "option+pagedown", "icon": "Arrow Down"},
    {"id": "44", "label": "Scroll page up", "shortcut": "option+pageup", "icon": "Arrow Down"},
    {"id": "45", "label": "Fold (collapse) region", "shortcut": "control+shift+keybracketleft", "icon": "Keyboard"},
    {"id": "46", "label": "Unfold (uncollapse) region", "shortcut": "control+shift+keybracketright", "icon": "Keyboard"},
    {"id": "47", "label": "Toggle Fold region", "shortcut": "control+k~control+l", "icon": "Shortcut Command"},
    {"id": "48", "label": "Fold (collapse) all subregions", "shortcut": "control+k~control+keybracketleft", "icon": "Shortcut Command"},
    {"id": "49", "label": "Unfold (uncollapse) all subregions", "shortcut": "control+k~control+keybracketright", "icon": "Shortcut Command"},
    {"id": "50", "label": "Fold (collapse) all regions", "shortcut": "control+k~control+0", "icon": "Shortcut Command"},
    {"id": "51", "label": "Unfold (uncollapse) all regions", "shortcut": "control+k~control+j", "icon": "Keyboard"},
    {"id": "52", "label": "Add line comment", "shortcut": "control+k~control+c", "icon": "Code"},
    {"id": "53", "label": "Remove line comment", "shortcut": "control+k~control+u", "icon": "Delete"},
    {"id": "54", "label": "Find next", "shortcut": "enter", "icon": "Search"},
    {"id": "55", "label": "Find Previous", "shortcut": "shift+enter", "icon": "Arrow Right"},
    {"id": "56", "label": "Select all occurrences of Find match", "shortcut": "option+enter", "icon": "Select All"},
    {"id": "57", "label": "Toggle Find Case Sensitive", "shortcut": "option+c", "icon": "Search"}
  ]
}
