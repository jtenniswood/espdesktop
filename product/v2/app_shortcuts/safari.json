      "shortcut": "command+l",
      "icon": "Spotlight"
    },
    {
      "id": "7",
      "label": "Show tab overview",
      "shortcut": "command+shift+keybackslash",
      "icon": "View Grid"
    },
    {
      "id": "8",
      "label": "Go to the next tab",
      "shortcut": "control+tab",
      "icon": "Tab"
    },
    {
      "id": "9",
