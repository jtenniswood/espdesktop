<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>Packaging/EspDesktop.ico</ApplicationIcon>
    <ApplicationManifest>Packaging/app.manifest</ApplicationManifest>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4370.26" />
    <PackageReference Include="System.IO.Ports" Version="10.0.15" />
    <InternalsVisibleTo Include="EspDesktop.Tests" />
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <EmbeddedResource Include="$(UsbEditorAsset)" LogicalName="UsbEditor.js" Condition="'$(UsbEditorAsset)' != ''" />
    <EmbeddedResource Include="../../product/v2/companion_capabilities.json" LogicalName="CompanionContract.json" />
    <EmbeddedResource Include="../../product/v2/app_shortcuts/platforms/windows/*.json"
                      LogicalName="WindowsAppShortcuts.%(Filename)%(Extension)" />
    <Resource Include="Packaging/EspDesktop.ico" />
    <Resource Include="Packaging/TrayComputer.ico" />
  </ItemGroup>
</Project>
